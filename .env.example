# Instagram API credentials
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id
# Facebook Page ID associated with the Instagram Business Account
# Required when INSTAGRAM_API_MODE=facebook-login for Page-scoped endpoints (e.g. conversations/messaging)
FACEBOOK_PAGE_ID=your_facebook_page_id
# Host/auth flow for Instagram API calls:
# - facebook-login -> graph.facebook.com (recommended for Acellere; broader coverage)
# - instagram-login -> graph.instagram.com (upstream-compatible default)
INSTAGRAM_API_MODE=facebook-login

# Threads API credentials
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# Meta App credentials (for token/webhook tools)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Acellere safety policy
# The fork starts read-only. Change to "write" only when mutation tools should
# be able to reach Meta. MCP annotations are advisory; this is enforced server-side.
ACELLERE_WRITE_MODE=read-only
# DELETE requests require this second opt-in even when writes are enabled.
ACELLERE_ALLOW_DESTRUCTIVE=false

# Optional: Meta API versions (defaults shown). Override only when Meta deprecates
# a version before meta-mcp ships a new release. Instagram Login OAuth token
# helpers are unversioned; Facebook Login tokens use Meta/Facebook's token flow.
# META_API_VERSION=v25.0
# THREADS_API_VERSION=v1.0

# Optional: transport. Default is stdio (standard for local MCP clients). Set to
# "http" to serve the MCP Streamable HTTP transport instead — for remote clients,
# cloud deployments, or multiple concurrent sessions. Listens on http://<host>:<port>/mcp.
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
# Comma-separated host:port allowlist for DNS-rebinding protection. Set this when
# binding to a non-loopback host; defaults to localhost variants at the bound port.
# MCP_HTTP_ALLOWED_HOSTS=

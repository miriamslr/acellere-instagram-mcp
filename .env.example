# Instagram API credentials — legacy fallback
# These remain the fallback only while no OAuth connection is active.
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id
# Facebook Page ID associated with the Instagram Business Account.
# Required when INSTAGRAM_API_MODE=facebook-login for Page-scoped endpoints.
FACEBOOK_PAGE_ID=your_facebook_page_id
# Legacy fallback host/auth flow:
# - facebook-login -> graph.facebook.com
# - instagram-login -> graph.instagram.com
INSTAGRAM_API_MODE=facebook-login

# Threads API credentials
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id

# Meta App credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Remote MCP authentication
AUTH_TOKEN=your_remote_mcp_auth_token

# Single Active Instagram Connection — OAuth switching
# The MCP keeps exactly one OAuth-connected Instagram account active at a time.
# Reconnecting another account replaces the active OAuth connection. If no
# OAuth connection exists, the legacy INSTAGRAM_* variables above are used.
#
# Secret used to encrypt OAuth access tokens before they are stored in the
# ActiveInstagramConnection Durable Object. Use a high-entropy value, e.g.
# `openssl rand -base64 32`. Configure as a Worker secret in production.
ACTIVE_CONNECTION_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
# OAuth callbacks must exactly match the Valid OAuth Redirect URIs configured
# in the Meta App Dashboard.
INSTAGRAM_OAUTH_REDIRECT_URI=https://your-worker.example.com/auth/instagram/callback
FACEBOOK_OAUTH_REDIRECT_URI=https://your-worker.example.com/auth/facebook/callback
# Optional fixed destination after a successful connection. If omitted, the
# Worker renders a minimal success page.
ACTIVE_CONNECTION_SUCCESS_REDIRECT_URI=https://app.example.com/integrations/instagram
# Optional app credential overrides. If omitted, META_APP_ID/META_APP_SECRET
# are reused for the corresponding OAuth flow.
# INSTAGRAM_OAUTH_CLIENT_ID=
# INSTAGRAM_OAUTH_CLIENT_SECRET=
# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=
# Optional comma-separated scope overrides. Defaults cover the core current
# Instagram management surface. Add ads/catalog scopes only after they are
# configured/approved for the Meta app.
# INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights
# FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_comments,instagram_manage_insights,instagram_content_publish,instagram_manage_messages

# Acellere safety policy
# Social writes to Meta are controlled independently from local runtime state.
ACELLERE_WRITE_MODE=read-only
# OAuth reconnect/disconnect changes only the Acellere local active-connection
# slot. Keep read-only until you intentionally want to switch accounts.
ACELLERE_LOCAL_STATE_WRITE_MODE=read-only
# DELETE requests to Meta require this second opt-in even when writes are enabled.
ACELLERE_ALLOW_DESTRUCTIVE=false

# Optional: Meta API versions (defaults shown).
# META_API_VERSION=v26.0
# THREADS_API_VERSION=v1.0

# Optional: transport. Default is stdio. Set to "http" for remote MCP.
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_ALLOWED_HOSTS=

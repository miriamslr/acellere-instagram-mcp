{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acellere-instagram-mcp",
  "main": "src/worker.ts",
  "account_id": "2bbf9af1af4a1d1466579ae28267a9b8",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV_DEDUPLICATION"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBHOOK_DEDUPLICATOR_DO",
        "class_name": "InstagramWebhookDeduplicatorDO"
      },
      {
        "name": "ACTIVE_INSTAGRAM_CONNECTION_DO",
        "class_name": "ActiveInstagramConnectionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "InstagramWebhookDeduplicatorDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ActiveInstagramConnectionDO"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "instagram-webhooks"
      }
    ]
  },
  "vars": {
    "INSTAGRAM_USER_ID": "17841421598761181",
    "FACEBOOK_PAGE_ID": "1266932313170442",
    "INSTAGRAM_API_MODE": "facebook-login",
    "META_API_VERSION": "v26.0",
    "ACELLERE_WRITE_MODE": "read-only",
    "ACELLERE_LOCAL_STATE_WRITE_MODE": "read-only",
    "ACELLERE_ALLOW_DESTRUCTIVE": "false"
  }
}
